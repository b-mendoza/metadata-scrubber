#!/bin/sh
# Reject a push that would add merge commits.
# Git sends one line per ref: local_ref local_sha remote_ref remote_sha.
# Allow deletions and tags. A tag can point to a merge that the remote already has.
set -eu

zero=0000000000000000000000000000000000000000
new=
old=
while read -r _local_ref local_sha remote_ref remote_sha; do
  case "$local_sha $remote_ref" in
    "$zero "* | *" refs/tags/"*) continue ;;
  esac
  new="$new $local_sha"
  old="$old $remote_sha"
done
[ -n "$new" ] || exit 0

# Exclude the advertised tips and the remote-tracking refs of a named remote.
# A URL matches no remote-tracking refs. --ignore-missing skips missing and zero SHAs.
# The SHA lists split on spaces on purpose.
# shellcheck disable=SC2086
merges=$(git log --merges --ignore-missing --format='  %h %s' $new --not "--remotes=$1" $old)
[ -n "$merges" ] || exit 0

{
  echo 'Push blocked. These commits are merge commits:'
  echo "$merges"
  echo 'Rebase onto the target branch. Then push your own branch:'
  echo '  git fetch origin && git rebase origin/main'
  echo '  git push --force-with-lease'
} >&2
exit 1
