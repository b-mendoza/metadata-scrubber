{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoMemoryEnabled": false,
  "disableBundledSkills": true,
  "enabledPlugins": {
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "cloudflare@cloudflare": true,
    "context7@context7-marketplace": true,
    "notion-workspace-plugin@notion-plugin-marketplace": true,
    "posthog@posthog": true,
    "vercel-plugin@vercel": true
  },
  "extraKnownMarketplaces": {
    "vercel": {
      "autoUpdate": true,
      "source": {
        "repo": "vercel/vercel-plugin",
        "source": "github"
      }
    },
    "cloudflare": {
      "autoUpdate": true,
      "source": {
        "repo": "cloudflare/skills",
        "source": "github"
      }
    },
    "context7-marketplace": {
      "autoUpdate": true,
      "source": {
        "repo": "upstash/context7",
        "source": "github"
      }
    },
    "posthog": {
      "autoUpdate": true,
      "source": {
        "repo": "PostHog/ai-plugin",
        "source": "github"
      }
    },
    "chrome-devtools-plugins": {
      "autoUpdate": true,
      "source": {
        "repo": "ChromeDevTools/chrome-devtools-mcp",
        "source": "github"
      }
    },
    "notion-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "makenotion/claude-code-notion-plugin"
      },
      "autoUpdate": true
    }
  },
  "workflowSizeGuideline": "medium"
}
