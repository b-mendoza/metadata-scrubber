# PORT defaults to 8080.
# Every other setting is required whenever the backend starts.
PORT=8080
R2_ACCESS_KEY_ID=synthetic-access-key-id
R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
R2_BUCKET=metadata-scrubber-example
R2_SECRET_ACCESS_KEY=synthetic-secret-access-key
# The required project token authenticates PostHog events, error tracking, and logs.
POSTHOG_PROJECT_TOKEN=phc_synthetic_project_token
