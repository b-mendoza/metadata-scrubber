{
  "name": "metadata-scrubber-backend",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
  },
  "workers_dev": false,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "BackendContainer",
      "image": "./Dockerfile",
      // Match Vercel Standard 2 GB / 1 vCPU; Cloudflare requires at least 3072 MiB for 1 vCPU.
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 3072,
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND_CONTAINER",
        "class_name": "BackendContainer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BackendContainer"],
    },
  ],
  // Deploy fails when one of these secrets is missing.
  "secrets": {
    "required": ["R2_ACCOUNT_ID", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"],
  },
  "vars": {
    "R2_BUCKET": "metadata-scrubber-prod",
  },
}
