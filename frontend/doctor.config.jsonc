{
  // Scan the full frontend, not only changed lines.
  "scope": "full",
  // Fail CI on warnings and errors.
  "blocking": "warning",
  // Skip the remote score API.
  "noScore": true,
  // Keep the dependency supply-chain scan out of this check.
  "supplyChain": { "enabled": false },
  "rules": {
    // The project keeps pnpm's default release age and trust settings, and Renovate's default 3-day npm delay.
    "react-doctor/require-pnpm-hardening": "off",
  },
  "ignore": {
    // Mirror the existing ESLint globalIgnores list.
    "files": [
      ".output/**",
      "coverage/**",
      "oxlint-plugin-metadata-scrubber/fixtures/**",
      "src/routeTree.gen.ts",
    ],
  },
}
