{
  "jsPlugins": ["./index.ts"],
  "rules": {
    "metadata-scrubber/no-classes": "error",
    "metadata-scrubber/no-expect-type-of": "error",
    "metadata-scrubber/no-lifecycle-hook-names": "error",
    "metadata-scrubber/no-module-scope-http-client": "error",
    "metadata-scrubber/no-mutable-module-state-in-server-code": "error",
    "metadata-scrubber/no-query-client-props": "error",
    "metadata-scrubber/no-silent-test-prerequisite": "error",
    "metadata-scrubber/no-test-local-object-type": "error",
    "metadata-scrubber/require-colocated-test": "error",
    "metadata-scrubber/require-module-file-name": "error",
    "metadata-scrubber/separate-type-imports": "error",
    "metadata-scrubber/use-effect-in-custom-hook": "error",
    "metadata-scrubber/use-shared-render-helper": "error"
  }
}
