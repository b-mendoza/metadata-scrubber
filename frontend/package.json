{
  "name": "metadata-scrubber",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "check:fixtures": "node oxlint-plugin-metadata-scrubber/check-fixtures.ts",
    "clean:hard": "node scripts/hard-clean.ts",
    "clean:soft": "node scripts/soft-clean.ts",
    "dev": "vite dev",
    "fix": "run-s --continue-on-error \"fix:*\"",
    "fix:eslint": "eslint --cache --cache-location node_modules/.cache/eslint --fix .",
    "fix:oxfmt": "oxfmt --write",
    "fix:oxlint": "oxlint --fix",
    "lint": "run-p --continue-on-error \"lint:*\"",
    "lint:doctor": "CI=1 REACT_DOCTOR_NO_TELEMETRY=1 react-doctor . --yes",
    "lint:eslint": "eslint --cache --cache-location node_modules/.cache/eslint --max-warnings 0 .",
    "lint:knip": "knip --no-progress",
    "lint:oxfmt": "oxfmt --check",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:types": "tsrs --build --pretty",
    "prepare": "cd .. && husky frontend/.husky",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
